# Public origin of the site, used for canonical URLs, Open Graph and the sitemap.
# Search engines may index the site only when this is set; without it (local,
# demo and preview deployments) every page is marked noindex.
NEXT_PUBLIC_SITE_URL=https://tipsly.se

# Optional map tiles from a commercial provider (CARTO, MapTiler, Stadia …).
# Without these the maps use Esri's keyless Light Gray Canvas.
# NEXT_PUBLIC_MAP_TILE_URL=https://example.com/tiles/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap, © Provider
